{
  "name": "@librarymarket/zodiac",
  "version": "1.0.2",
  "description": "A carousel written in TypeScript.",
  "type": "module",
  "main": "./dist/zodiac.esm.js",
  "module": "./dist/zodiac.esm.js",
  "style": "./dist/css/zodiac.css",
  "browserslist": [
    "defaults"
  ],
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass --style expanded --no-error-css src/assets/scss/zodiac.scss dist/css/zodiac.css",
    "build:js": "rollup -cm",
    "lint": "npm run lint:css && npm run lint:js",
    "lint:css": "stylelint \"./src/assets/scss/*.scss\" --cache --cache-location .cache/.stylelintcache --rd",
    "lint:js": "tsc --noEmit && eslint src",
    "test": "jest",
    "watch:css": "sass --watch src/assets/scss/zodiac.scss:dist/css/zodiac.css",
    "watch:js": "rollup -cmw",
    "watch": "concurrently --kill-others \"npm:watch:css\" \"npm:watch:js\"",
    "dev": "npm run watch",
    "prepack": "npm run build"
  },
  "author": "jeremyljackson",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "rollup": "^4.63.1",
    "sass": "^1.104.0",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "ts-jest": "^29.4.12",
    "typescript-eslint": "^8.70.0",
    "typescript": "^5.9.3"
  }
}
